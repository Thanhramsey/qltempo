rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      // Bypassed because Firebase Auth anonymous sign-ins/sign-ups are restricted on the project level ("ADMIN_ONLY_OPERATION")
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidString(val, minSize, maxSize) {
      return val is string && val.size() >= minSize && val.size() <= maxSize;
    }

    // Shift validation
    function isValidShift(data) {
      return isValidId(data.id) &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.time, 1, 100) &&
             isValidString(data.course, 1, 100) &&
             (data.weekday is string || data.days is list) &&
             (data.get("weekday", "") is string) &&
             (data.get("createdAt", "") is string);
    }

    // Student validation
    function isValidStudent(data) {
      return isValidId(data.id) &&
             isValidString(data.name, 1, 100) &&
             (data.get("phone", "") is string) && data.get("phone", "").size() <= 50 &&
             (data.get("email", "") is string) &&
             (data.get("birthDate", "") is string) &&
             data.shifts is list &&
             (data.status == "active" || data.status == "inactive") &&
             isValidString(data.joinDate, 8, 20) &&
             (data.get("createdAt", "") is string);
    }

    // Attendance validation
    function isValidAttendance(data) {
      return isValidId(data.id) &&
             isValidString(data.date, 10, 10) &&
             isValidString(data.shiftId, 1, 100) &&
             isValidString(data.studentId, 1, 100) &&
             (data.status == "present" || data.status == "absent_excused" || data.status == "absent_unexcused");
    }

    // Payment validation
    function isValidPayment(data) {
      let hasLegacyFields =
        isValidString(data.get("shiftId", ""), 1, 100) &&
        isValidString(data.get("month", ""), 1, 20);

      let hasCycleFields =
        (data.get("cycleIndex", 0) is number) && data.get("cycleIndex", 0) >= 1 &&
        (data.get("sessionsTarget", 0) is number) && data.get("sessionsTarget", 0) >= 1;

      return isValidId(data.id) &&
             isValidString(data.studentId, 1, 100) &&
             (hasLegacyFields || hasCycleFields) &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             (data.status == "paid" || data.status == "unpaid" || data.status == "partial");
    }

    // User account validation
    function isValidUser(data) {
      return isValidId(data.id) &&
             isValidString(data.name, 1, 150) &&
             isValidString(data.email, 1, 150) &&
             (data.role == "admin" || data.role == "staff" || data.role == "teacher") &&
             (data.get("password", "") is string) &&
             (data.get("createdAt", "") is string);
    }

    // Tuition cycle config validation
    function isValidTuitionCycleConfig(data) {
      return isValidId(data.id) &&
             isValidString(data.name, 1, 120) &&
             (data.sessionsTarget is number) && data.sessionsTarget >= 1 &&
             (data.feeVnd is number) && data.feeVnd >= 0 &&
             (data.excusedAbsenceFree is number) && data.excusedAbsenceFree >= 0 &&
             (data.unexcusedAbsenceFree is number) && data.unexcusedAbsenceFree >= 0 &&
             (data.warningFromSession is number) && data.warningFromSession >= 1 &&
             (data.get("createdAt", "") is string);
    }

    // Collection matching
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(shiftId) && isValidShift(request.resource.data);
      allow delete: if isSignedIn() && isValidId(shiftId);
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(studentId) && isValidStudent(request.resource.data);
      allow delete: if isSignedIn() && isValidId(studentId);
    }

    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(request.resource.data);
      allow delete: if isSignedIn() && isValidId(attendanceId);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId) && isValidPayment(request.resource.data);
      allow delete: if isSignedIn() && isValidId(paymentId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isSignedIn() && isValidId(userId);
    }

    match /tuitionCycleConfigs/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(configId) && isValidTuitionCycleConfig(request.resource.data);
      allow delete: if isSignedIn() && isValidId(configId);
    }
  }
}
